# Postgres-tilkobling.
# Lokalt (Docker): postgres://trappapp:trappapp@localhost:55432/trappapp
# Supabase: Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgres://trappapp:trappapp@localhost:55432/trappapp

# Passord til /admin. Sett noe langt og tilfeldig i produksjon.
ADMIN_PASSWORD=bytt-meg

# Hemmelighet som signerer admin-informasjonskapselen.
# Lag en ny med: openssl rand -hex 32
ADMIN_SECRET=bytt-meg-ogsaa

# Hemmelighet som signerer innloggings-kapselen til deltakerne.
# Valgfri: uten den brukes ADMIN_SECRET med en egen etikett.
SESSION_SECRET=

# API-nøkkel fra resend.com. Uten den sendes ingen e-post – koden skrives
# i stedet til serverkonsollen, slik at flyten kan testes lokalt.
RESEND_API_KEY=

# Avsender. Resend sitt testdomene når bare kontoeierens egen adresse.
# Med eget verifisert domene: TrappApp <no-reply@trappapp.no>
EMAIL_FROM=TrappApp <onboarding@resend.dev>

# Adressen som varsles når noen melder om et problem via /support.
# Uten den lagres meldingen likevel, og vises i admin.
SUPPORT_EMAIL=

# Valgfri begrensning til ett domene, f.eks. boitano.no. Står tom, slik at
# ansatte kan bruke privat e-post hvis de foretrekker det. Settes den, stenges
# samtidig utenforstående ute fra å registrere seg.
ALLOWED_EMAIL_DOMAIN=

# Full URL til appen. Brukes i QR-kodene på plakatene.
# Lokalt kan denne stå tom – da leses adressen fra forespørselen.
NEXT_PUBLIC_APP_URL=
